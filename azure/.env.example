# Copy this file to azure/.env and fill in your own values.
# `azure/.env` is gitignored — never commit it.

# Your Azure subscription ID. Find it with:  az account show --query id -o tsv
AZURE_SUBSCRIPTION_ID="00000000-0000-0000-0000-000000000000"

# All resources live inside this resource group.
RESOURCE_GROUP="diana-churn-rg"

# Azure region. westeurope / francecentral / eastus are common student picks.
LOCATION="westeurope"

# Azure Container Registry name (must be 5–50 chars, lowercase, globally unique).
ACR_NAME="dianachurn$(whoami | tr -cd 'a-z0-9' | cut -c1-12)"

# Container Apps environment + app names.
ACA_ENVIRONMENT="diana-churn-env"
ACA_APP_NAME="diana-churn-api"

# Image tag pushed to ACR and deployed to the Container App.
IMAGE_TAG="v1"
